{
    "manufacturer": "Ronnie Bathoorn",
    "keyboard_name": "Dyad split proto",
    "maintainer": "bathoorn",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "usb": {
        "vid": "0xFEED",
        "pid": "0xD9AE",
        "device_version": "0.0.1"
    },
    "features": {
        "bootmagic": false,
        "command": false,
        "console": true,
        "encoder": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "pointing_device": true
    },
    "diode_direction": "COL2ROW",
    "matrix_pins": {
        "cols": ["GP6", "GP7"],
        "rows": ["GP8", "GP9"]
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP10", "pin_b": "GP11"}
        ]
    },
    "split": {
        "enabled": true,
        "handedness": {
            "pin": "GP12"
        },
        "matrix_pins": {
            "right": {
                "cols": ["GP6", "GP7"],
                "rows": ["GP8", "GP9"]
            }
        },
        "encoder": {
            "right": {
                "rotary": [
                    {"pin_a": "GP10", "pin_b": "GP11"}
                ]
            }
        }
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},

                {"matrix": [2, 0], "x": 4, "y": 0},
                {"matrix": [2, 1], "x": 5, "y": 0},
                {"matrix": [3, 0], "x": 4, "y": 1},
                {"matrix": [3, 1], "x": 5, "y": 1}
            ]
        }
    }
}
